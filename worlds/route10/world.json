  "buildings": {
    "mill-pond-inn": {
      "name": "Mill Pond Inn",
      "wall": "#8a6d4e",
      "roof": "#5b4632",
      "sign": [
        "Pizza night Monday and Wednesday, chalked by the door in a hand that has written it a hundred times.",
        "The mill pond sits right behind the place, and on a warm evening the door stays propped so the talk carries out over the water."
      ]
    },
    "jefferson-town-hall": {
      "name": "Jefferson Town Hall",
      "wall": "#d9d2c0",
      "roof": "#6d6a5c",
      "sign": [
        "Posted hours end at 2 PM most days. The board agenda lists road salt bids and 'the goat situation (continued).'",
        "Meeting nights are posted, court sits about once a month, and metal recycling is the first Saturday. Small things, kept up carefully."
      ]
    },
    "heartbreak-hotel": {
      "name": "Heartbreak Hotel",
      "wall": "#a34a4a",
      "roof": "#6e2f2f",
      "sign": [
        "A hand-lettered sign by the door: PRIME RIB SATURDAY. MAKE A RESERVATION. WE MEAN IT.",
        "Two hearts up under the roofline, a porch light on early, and somebody inside already laughing at the bar."
      ]
    },
    "middle-brook-cafe": {
      "name": "Middle Brook Cafe",
      "wall": "#c2a15c",
      "roof": "#7c6236",
      "sign": [
        "The stone patio out front is filling up, and there is a cup on nearly every table catching the morning sun.",
        "Inside, a customer is explaining, with great intensity, that the chocolate chip cookie is somehow vegan."
      ]
    },
    "stewarts": {
      "name": "Stewart's",
      "wall": "#e4e0d4",
      "roof": "#b5542a",
      "sign": [
        "Coffee in one hand and a cone in the other, and the whole junction of NY 10 and NY 23 going by the window.",
        "Taped to the ice cream case inside, a hand-written sheet keeps the softball league standings current."
      ]
    },
    "mac-a-doodles": {
      "name": "Mac-A-Doodles",
      "wall": "#7a8fb0",
      "roof": "#4d5f7d",
      "sign": [
        "Ice cream is the main event here: the soft-serve window, cones going out steadily, and kids at the counter choosing with real seriousness.",
        "A dog outside is finishing a pup cup with real focus. The menu board also offers a mac-n-cheese burger, and it is not a dare."
      ]
    },
    "stamford-coffee": {
      "name": "Stamford Coffee",
      "wall": "#6f5b7d",
      "roof": "#4a3c55",
      "sign": [
        "The patio out front is half the building: tables full, a dog asleep under one, and somebody ordering a Maple Smoke latte.",
        "This is where the week gets talked over. Through the side doorway, 80 Main's shelves are calling."
      ]
    },
    "the-belvedere": {
      "name": "The Belvedere",
      "wall": "#93a86f",
      "roof": "#5c6b41",
      "sign": [
        "Up the hill and lit early, and it sounds like everybody in there knows everybody.",
        "A taped-up flyer teases a big-name comedian, headed this way one of these days. DATE TBA. Guess you'll just have to keep checking back."
      ]
    },
    "cellar-door-wines": {
      "name": "Cellar Door Wines",
      "wall": "#5d4a3a",
      "roof": "#3c2f24",
      "sign": [
        "Through the window, the owner is walking a couple through an Austrian orange wine. Nobody leaves this shop empty-handed.",
        "Out front there is a bench, and if you sit on it for any length of time a friend is sure to stop in."
      ]
    },
    "tops": {
      "name": "Tops",
      "wall": "#cdd3c4",
      "roof": "#6f7a66",
      "sign": [
        "Carts nosed into the corral, the bulletin board by the door three layers deep, and half the lot waving at the other half.",
        "Someone loading a trunk, to nobody in particular: \"Produce selection isn't great, but it beats a thirty-minute trip when you forgot the milk.\""
      ]
    },
    "stamford-library": {
      "name": "Stamford Library",
      "wall": "#c9b791",
      "roof": "#7a6647",
      "sign": [
        "A jigsaw half-done on the table inside the window, one whole corner still sky. A card beside it: TAKE A PIECE, LEAVE A PIECE.",
        "Story hour Thursday mornings, says the sign on the door, in careful marker with a cat drawn in the corner."
      ]
    },
    "stamford-fire-department": {
      "name": "Stamford Fire Department",
      "wall": "#b0523a",
      "roof": "#6b3324",
      "sign": [
        "Chalked on a board by the bay doors: PANCAKE BREAKFAST SUNDAY, 8 TO NOON. Underneath, smaller: chicken barbecue in July.",
        "Half the town volunteers here, on their own time, and the other half turns up for the pancakes. Every name on the roster inside is somebody you passed on Main Street today."
      ]
    },
    "solinskys": {
      "name": "Solinsky's",
      "wall": "#d8c3b0",
      "roof": "#8a5a4a",
      "sign": [
        "The smoke reaches the sidewalk a few doors early, and there is already a friendly little line of regulars working its way to the case.",
        "Sign by the register: BRISKET SANDWICHES SATURDAY. Underneath, in a different hand: come early, they go."
      ]
    },
    "johns-tavern": {
      "name": "John's Tavern",
      "wall": "#7d6a52",
      "roof": "#4a3d2d",
      "sign": [
        "Door propped open, a game on somewhere in the back, and a laugh going up at something that happened three innings ago.",
        "Nobody dresses up for John's, and nobody needs to. Grab a stool; somebody will want to know how your week went."
      ]
    },
    "eighty-main": {
      "name": "80 Main",
      "wall": "#c9b8a0",
      "roof": "#6d5a44",
      "sign": [
        "Candles and mugs made close to home on one shelf, and on the next a very good sweater and some camo that is more fashion than deer season.",
        "Its door and Stamford Coffee's open onto the same patio, so a browse and a cup of coffee turn into one errand."
      ]
    },
    "tps-cafe": {
      "name": "T.P.'s Cafe",
      "wall": "#c98f6a",
      "roof": "#7d5236",
      "sign": [
        "Breakfast comes right out onto Railroad Avenue: eggs, toast, coffee going round. Half the stools at the counter know each other's orders.",
        "Ace Hardware is right next door, so breakfast here tends to come with a plan for the afternoon."
      ]
    },
    "ace-hardware": {
      "name": "Ace Hardware",
      "wall": "#8fa8a0",
      "roof": "#4f6660",
      "sign": [
        "Saturday morning, and the lot is full: a good share of it people who moved up here, bought a place that needed work, and are happily still at it.",
        "Someone comes in holding one mystery part; someone behind the counter says \"aisle four, halfway down\" without looking up."
      ]
    },
    "jh-gas-station": {
      "name": "J&H",
      "wall": "#d6d2c4",
      "roof": "#8f3b2b",
      "sign": [
        "Pumps out front, and a deli counter inside that has most of the village's mornings covered: coffee, egg sandwiches, and the first news of the day.",
        "Half the trucks in the lot belong to somebody's contractor. If you have been trying to reach one, this is where they all are at seven in the morning."
      ]
    }
  },
