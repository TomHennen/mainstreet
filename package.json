{
  "name": "mainstreet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Engine for small, episodic, pixel-art town games.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
